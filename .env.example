# Application
APP_NAME=status-page-service
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Server
# Cloud Run injects PORT automatically (typically 8080).
# For local dev, leave as 8000 or override as needed.
PORT=8000

# CORS — comma-separated list of allowed origins.
# Add your Cloudflare Pages URL here.
CORS_ORIGINS=http://localhost:3000,https://your-site.pages.dev

# Database
DATABASE_URL=sqlite+aiosqlite:///./status.db

# How often to re-check service health (seconds). Default: 300 (5 min).
CHECK_INTERVAL_SECONDS=300
